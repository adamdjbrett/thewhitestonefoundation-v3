---
layout: base.njk
title: "Our Contributors"
description: "Meet the amazing authors who contribute to our content."
permalink: /authors/
---

<section class="page-shell">
  <header class="page-header page-header--center">
    <p class="eyebrow">Directory</p>
    <h1>{{ title }}</h1>
    <p>{{ description }}</p>
  </header>

  <div class="author-grid">
    {% for author in collections.authors %}
      <a href="{{ author.url }}" class="author-card">
        <img src="{{ author.data.image or metadata.image }}" alt="{{ author.data.name }}" loading="lazy">
        <h2>{{ author.data.name }}</h2>
        <p>{{ author.data.role }}</p>
      </a>
    {% endfor %}
  </div>
</section>
