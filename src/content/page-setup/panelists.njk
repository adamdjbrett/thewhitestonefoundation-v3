---
layout: base.njk
title: "Panelists"
categories:
tags:
image: /images/wp-content/uploads/2021/08/Whitestone-logo.png
permalink: /panelists/
info: |
  #### The following are panelists for the Whitestone Foundation’s Thought Leader Symposium #1 entitled [“The Existential Crisis of Learning and the Future of the Knowledge Economy” ](/events/)on Nov. 12, 2025.
---

<section class="page-shell">
  <header class="page-header">
    <p class="eyebrow">Symposium</p>
    <h1>{{ title }}</h1>
    <div class="prose-green">{{ info | md | safe }}</div>
  </header>

  <div class="panelist-grid">
    {% for person in panelistsData.list %}
      <article class="panelist-card">
        <div class="panelist-card__image">
          <img src="{{ person.photo }}" alt="{{ person.name }}" loading="lazy">
        </div>
        <div class="panelist-card__body">
          <h2>{{ person.name }}</h2>
          <div class="description">{{ person.description | stripHtml | safe }}</div>
        </div>
      </article>
    {% else %}
      <p>No panelists found.</p>
    {% endfor %}
  </div>
</section>
