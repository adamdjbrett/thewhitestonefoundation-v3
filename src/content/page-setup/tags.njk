---
layout: base.njk
title: "All Tags"
description: "Explore articles by topic with our comprehensive tag index."
permalink: /tags/
---

<section class="page-shell">
  <header class="page-header">
    <p class="eyebrow">Index</p>
    <h1>{{ title }}</h1>
    <p>{{ description }}</p>
  </header>

  <div class="tag-cloud">
    {% for tag in collections | getKeys | filterTagList %}
      {% set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
      <a href="{{ tagUrl }}" class="tag-pill">
        {{ tag }} 
        <span>{{ collections[tag].length }}</span>
      </a>
    {% endfor %}
  </div>
</section>
