---js
{
  pagination: {
    data: "collections",
    size: 1,
    alias: "tag",
    filter: ["all", "posts", "higherEd", "authors", "archivesIndex"],
    addAllPagesToCollections: true
  },
  layout: "base.njk",
  eleventyExcludeFromCollections: true,
  eleventyComputed: {
    title: "Tagged '{{ tag }}'",
    permalink: function(data) {
      return `/tags/${this.slugify(data.tag)}/`;
    }
  }
}
---

<section class="page-shell">
  <header class="page-header">
    <p class="eyebrow">Tag</p>
    <h1>{{ tag }}</h1>
    <p>Showing {{ collections[tag].length }} articles found in this tag.</p>
  </header>

  {% set postslist = collections[tag] %}
  {% include "postslist.njk" %}

  <div class="page-actions">
    <a href="/tags/" class="button button--outline">&larr; Back to all tags</a>
  </div>
</section>
