---
layout: base.njk
title: "News"
description: "Stay updated with the latest news and articles from The Whitestone Foundation."
pagination:
  data: collections.posts
  size: 2
  alias: news
  reverse: true
eleventyComputed:
  permalink: "news/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---
<section class="page-shell">
  <header class="page-header">
    <p class="eyebrow">News</p>
    <h1>{{ title }}</h1>
    <p>{{ description }} Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}.</p>
  </header>

  <div class="listing-grid">
    {% for p in news %}
      <article class="article-card">
        <a href="{{ p.url }}">
          <div class="article-card__image">
            <img src="{{ p.data.image or metadata.image }}" alt="{{ p.data.title }}" loading="lazy">
          </div>
          <p class="card-meta">
            {{ p.data.categories[0] if p.data.categories else "General" }} • {{ p.date | readableDate }}
          </p>
          <h2>{{ p.data.title }}</h2>
          <p>{{ p.data.description or p.content | stripHtml | truncate(150) }}</p>
        </a>
      </article>
    {% else %}
      <p>No posts found.</p>
    {% endfor %}
  </div>

  {% if pagination.pages.length > 1 %}
    <nav class="pagination-nav">
      {% if pagination.href.previous %}
        <a href="{{ pagination.href.previous }}" class="button button--outline">← Newer</a>
      {% else %}
        <span>First Page</span>
      {% endif %}

      <div>
        {% for pageEntry in pagination.pages %}
          <a href="{{ pagination.hrefs[loop.index0] }}" class="{% if pagination.pageNumber == loop.index0 %}is-active{% endif %}">
            {{ loop.index }}
          </a>
        {% endfor %}
      </div>

      {% if pagination.href.next %}
        <a href="{{ pagination.href.next }}" class="button button--outline">Older →</a>
      {% else %}
        <span>Last Page</span>
      {% endif %}
    </nav>
  {% endif %}
</section>
