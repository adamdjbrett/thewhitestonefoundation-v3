---
layout: base.njk
title: "Categories"
description: "Explore our content by major editorial categories"
permalink: /categories/
---

<section class="page-shell">
  <header class="page-header">
    <p class="eyebrow">Index</p>
    <h1>{{ title }}</h1>
    <p>{{ description }}.</p>
  </header>

  <div class="listing-grid listing-grid--compact">
    {% for cat in collections.posts | getAllCategories %}
      {% set catUrl %}/categories/{{ cat | slugify }}/{% endset %}
      <a href="{{ catUrl }}" class="category-card">
        <h2>{{ cat }}</h2>
      </a>
    {% endfor %}
  </div>
</section>
