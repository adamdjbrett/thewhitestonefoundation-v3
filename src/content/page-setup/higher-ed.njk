---
layout: base.njk
title: "Higher Ed"
pagination:
  data: collections.higherEd
  size: 6
  alias: posts
eleventyComputed:
  permalink: "higher-ed/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---

<section class="page-shell">
  <header class="page-header">
    <p class="eyebrow">Program</p>
    <h1>{{ title }}</h1>
    <p>Rethinking Higher Education Totally... Exploring the future of academic institutions and rethinking educational structures.</p>
  </header>

  <div class="page-actions page-actions--top">
    <a href="/" class="button button--outline">Back Home</a>
  </div>

  <div class="listing-grid">
    {% for p in posts %}
      <article class="article-card">
        <a href="{{ p.url }}">
          <div class="article-card__image">
            <img src="{{ p.data.image or metadata.image }}" alt="{{ p.data.title }}" loading="lazy">
          </div>
          <p class="card-meta">{{ p.data.categories[0] if p.data.categories else "Higher Ed" }} • {{ p.date | readableDate }}</p>
          <h2>{{ p.data.title }}</h2>
          <p>{{ p.data.description or p.content | stripHtml | truncate(150) }}</p>
        </a>
      </article>
    {% else %}
      <p>No posts found yet.</p>
    {% endfor %}
  </div>

  {% if pagination.pages.length > 1 %}
  <nav class="pagination-nav">
    {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}" class="button button--outline">← Newer</a>
    {% else %}
      <span>Start</span>
    {% endif %}
    <div>
      {% for pageHref in pagination.hrefs %}
        <a href="{{ pageHref }}" class="{% if pagination.pageNumber == loop.index0 %}is-active{% endif %}">{{ loop.index }}</a>
      {% endfor %}
    </div>
    {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}" class="button button--outline">Older →</a>
    {% else %}
      <span>End</span>
    {% endif %}
  </nav>
  {% endif %}
</section>
