---
layout: base.njk
title: "People"
description: "Meet the dedicated team and scholars behind The Whitestone Foundation and our publications."
permalink: /people/
---
<section class="page-shell">
  <header class="page-header">
    <p class="eyebrow">Directory</p>
    <h1>{{ title }}</h1>
    <p>{{ description }}</p>
  </header>

  <div class="people-grid">
    {% for member in team.active %}
      <article class="team-card">
        <div class="team-card__image team-card__image--square">
          <img src="{{ member.photo or metadata.image }}" alt="{{ member.name }}" loading="lazy">
        </div>
        <div class="team-card__body">
          <p class="card-meta">{{ member.role }}</p>
          <h2>{{ member.name }}</h2>
          <p>{{ member.description | stripHtml | truncate(200) }}</p>
        </div>
      </article>
    {% endfor %}
  </div>

  {% if team.alumni %}
    <div class="alumni-list">
      <h2>Alumni</h2>
      <div class="listing-grid">
      {% for member in team.alumni %}
        <article class="alumni-card">
          <img src="{{ member.photo or metadata.image }}" alt="{{ member.name }}" loading="lazy">
          <div>
            <h3>{{ member.name }}</h3>
            <p>{{ member.description | stripHtml | truncate(120) }}</p>
          </div>
        </article>
      {% endfor %}
      </div>
    </div>
  {% endif %}
</section>
