{% import "partials/icon.njk" as icons %}
<nav class="site-nav" data-site-nav>
  <div class="site-container">
    <div class="nav-row">
      <a href="/" class="brand-mark">
        <span class="brand-diamond">
          <span>W</span>
        </span>
        <span class="brand-name">Whitestone</span>
      </a>

      <div class="desktop-nav">
        {% for link in home.nav %}
          <a href="/{{ link.href }}">{{ link.label }}</a>
        {% endfor %}
        <a href="/#support" class="button button--small button--pill">Support</a>
      </div>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Toggle navigation" data-nav-toggle>
        <span class="nav-toggle__open">{{ icons.icon("menu") }}</span>
        <span class="nav-toggle__close" hidden>{{ icons.icon("x") }}</span>
      </button>
    </div>
  </div>
</nav>

<div id="mobile-nav" class="mobile-nav" data-mobile-nav>
  <div class="mobile-nav__inner">
    {% for link in home.nav %}
      <a href="/{{ link.href }}">{{ link.label }}</a>
    {% endfor %}
    <a href="/#support" class="button button--pill">Support Our Mission</a>
  </div>
</div>
