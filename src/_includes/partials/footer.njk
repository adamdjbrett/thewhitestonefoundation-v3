<footer class="site-footer">
  <div class="site-container">
    <div class="footer-grid">
      <div class="footer-about">
        <div class="brand-mark brand-mark--light">
          <div class="brand-diamond">
            <img src="{{ metadata.brand.mark }}" alt="" aria-hidden="true">
          </div>
          <span class="brand-name">{{ metadata.footer.brand }}</span>
        </div>
        <p>
          {{ metadata.footer.about }}
        </p>
      </div>

      <div>
        <p class="footer-heading">{{ metadata.footer.navigation_heading }}</p>
        <div class="footer-links">
          {% for link in home.nav %}
            <a href="/{{ link.href }}">{{ link.label }}</a>
          {% endfor %}
          <a href="{{ metadata.routes.contact }}">{{ metadata.labels.contact }}</a>
        </div>
      </div>

      <div>
        <p class="footer-heading">{{ metadata.footer.journals_heading }}</p>
        <div class="footer-links">
          {% for publication in home.publications %}
            <a href="{{ publication.url }}">
              {{ publication.title }}
              <span aria-hidden="true">{{ metadata.symbols.external }}</span>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {% year %} {{ metadata.footer.copyright_name }}. {{ metadata.footer.copyright_rights }}</p>
      <p>{{ metadata.footer.legal }}</p>
    </div>
  </div>
</footer>
