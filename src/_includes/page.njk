{% extends "base.njk" %}

{% block content %}
<article class="page-shell">
  <header class="page-header">
    <p class="eyebrow">The Whitestone Foundation</p>
    <h1>{{ title }}</h1>
    {% if description %}<p>{{ description }}</p>{% endif %}
  </header>
  <div class="prose-green">
    {{ content | safe }}
  </div>
</article>
{% endblock %}
