{% extends "base.njk" %}

{% block content %}
<article class="page-shell">
  <header class="page-header">
    <p class="eyebrow">
      {% if categories and categories.length %}{{ categories[0] }}{% else %}News{% endif %}
      {% if date %} · {{ date | readableDate }}{% endif %}
    </p>
    <h1>{{ title }}</h1>
    {% if description %}<p>{{ description }}</p>{% endif %}
  </header>
  {% if image %}
    <img class="feature-image" src="{{ image }}" alt="{{ title }}" loading="lazy">
  {% endif %}
  <div class="prose-green">
    {{ content | safe }}
  </div>
</article>
{% endblock %}
