{% extends "base.njk" %}

{% block content %}
<article class="page-shell">
  <header class="page-header">
    <p class="eyebrow">
      {% if categories and categories.length %}{{ categories[0] }}{% else %}{{ metadata.labels.news }}{% endif %}
      {% if date %} {{ metadata.symbols.separator }} {{ date | readableDate }}{% endif %}
    </p>
    <h1>{{ title }}</h1>
    {% if description %}<p>{{ description }}</p>{% endif %}
    <div class="post-meta post-meta--full" aria-label="Post metadata">
      {% if author %}
        <span>By {{ author | titleCaseTerm }}</span>
      {% endif %}
      {% if categories and categories.length %}
        {% for category in categories %}
          <span>{{ category | titleCaseTerm }}</span>
        {% endfor %}
      {% endif %}
    </div>
  </header>
  {% if image %}
    <img class="feature-image" src="{{ image }}" alt="{{ title }}" loading="lazy">
  {% endif %}
  <div class="prose-green">
    {{ content | safe }}
  </div>

  <footer class="post-taxonomy">
    {% if categories and categories.length %}
      <section class="taxonomy-panel">
        <h2>Categories</h2>
        <div class="tag-cloud">
          {% for category in categories %}
            <span class="tag-pill">{{ category | titleCaseTerm }}</span>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <section class="taxonomy-panel">
      <h2>Posts</h2>
      <div class="link-stack">
        {% if collections.posts.length > 1 %}
          {% set recentPosts = collections.posts | reverse %}
          {% for post in recentPosts %}
            {% if post.url != page.url %}
              <a href="{{ post.url }}">
                <span>{{ post.data.title }}</span>
                <small>{{ post.date | readableDate }}</small>
              </a>
            {% endif %}
          {% endfor %}
        {% else %}
          <p>No additional posts found.</p>
        {% endif %}
      </div>
    </section>

    {% if collections.postAuthors and collections.postAuthors.length %}
      <section class="taxonomy-panel">
        <h2>Authors</h2>
        <div class="tag-cloud">
          {% for postAuthor in collections.postAuthors %}
            <span class="tag-pill">
              {{ postAuthor.name | titleCaseTerm }}
              <span>{{ postAuthor.count }}</span>
            </span>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </footer>
</article>
{% endblock %}
