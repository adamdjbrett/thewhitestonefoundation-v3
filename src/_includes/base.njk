<!DOCTYPE html>
<html lang="{{ lang | default(settings.defaultLanguage) }}">
  <baseline-head></baseline-head>
  <body class="bg-canvas text-ink font-body">
    <a href="#document" class="skip-link">Skip to main content</a>
    {% include "partials/nav.njk" %}
    <main id="document" tabindex="-1" class="{% block mainClass %}{% endblock %}">
      {% block content %}{{ content | safe }}{% endblock %}
    </main>
    {% include "partials/footer.njk" %}
  </body>
</html>
