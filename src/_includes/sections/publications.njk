<section id="publications" class="section section--dark section--angled">
  <div class="diagonal-top"></div>
  <div class="site-container">
    <div class="section-heading reveal">
      <p class="eyebrow eyebrow--light">Publications</p>
      <h2>
        Open Access <span>Scholarship</span>
      </h2>
    </div>
    <div class="publication-grid">
      {% for pub in home.publications %}
        <a href="{{ pub.url }}" class="publication-card reveal">
          <div class="publication-card__image">
            <img src="{{ pub.image }}" alt="{{ pub.title }}">
            <div></div>
          </div>
          <div class="publication-card__body">
            <p>{{ pub.abbr }}</p>
            <h3>{{ pub.title }}</h3>
            <span>{{ pub.description }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
  <div class="diagonal-bottom"></div>
</section>
