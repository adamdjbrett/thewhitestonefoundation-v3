<section id="team" class="section section--light section--border">
  <div class="site-container">
    <div class="split-heading split-heading--compact reveal">
      <div>
        <p class="eyebrow">Our People</p>
        <h2>
          The Minds <span>Behind the Mission</span>
        </h2>
      </div>
      <div class="section-copy">
        
        <p>Our team of scholars, editors, and board members bring decades of expertise in philosophy, cultural theory, and public scholarship to everything we publish.</p>
      </div>
    </div>

    <div class="people-grid">
      {% for member in team.active %}
        {% set role = "Editorial" %}
        {% if "President" in member.role or "Secretary" in member.role or "Board" in member.role %}
          {% set role = "Leadership" %}
        {% endif %}
        <article class="team-card reveal">
          <div class="corner corner-tl"></div>
          <div class="corner corner-br"></div>
          <div class="team-card__image">
            <img src="{{ member.photo | default('/images/default-avatar.png') }}" alt="{{ member.name }}" loading="lazy">
            <span class="role-badge">{{ role }}</span>
          </div>
          <div class="team-card__body">
            <p class="card-meta">{{ member.role }}</p>
            <h3>{{ member.name }}</h3>
            <p>{{ member.description | stripHtml | truncate(220) }}</p>
            <a href="/people/" class="text-link">View Full Profile <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      {% endfor %}
    </div>

    {% if team.alumni %}
      <div class="alumni-intro reveal">
        <div><span aria-hidden="true">●</span><span>Alumni</span></div>
        <p>We are grateful to the talented individuals who contributed to Whitestone Publications and continue their scholarly journeys.</p>
      </div>
      <div class="people-grid">
        {% for member in team.alumni %}
          <article class="team-card reveal">
            <div class="team-card__image">
              <img src="{{ member.photo | default('/images/default-avatar.png') }}" alt="{{ member.name }}" loading="lazy">
              <span class="role-badge role-badge--alumni">Alumni</span>
            </div>
            <div class="team-card__body">
              <h3>{{ member.name }}</h3>
              <p>{{ member.description | stripHtml | truncate(220) }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    <div class="section-action reveal">
      <a href="/people/" class="button button--outline">View Full Team Directory <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>