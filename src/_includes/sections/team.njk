{% import "partials/card.njk" as cards %}
<section id="team" class="section section--team section--border">
  <div class="site-container">
    <div class="split-heading split-heading--compact reveal">
      <div>
        <p class="eyebrow">{{ teamSection.eyebrow }}</p>
        <h2>
          {{ teamSection.title }} <span>{{ teamSection.titleSpan }}</span>
        </h2>
      </div>
      <div class="section-copy">
        <p>{{ teamSection.description }}</p>
      </div>
    </div>

    <div class="people-grid">
      {% for member in collections.teamActive %}
        {% set role = "Editorial" %}
        {% if "President" in member.data.role or "Secretary" in member.data.role or "Board" in member.data.role %}
          {% set role = "Leadership" %}
        {% endif %}
        {{ cards.person(member, metadata, { reveal: true, corners: true, badge: role, clickable: true }) }}
      {% endfor %}
    </div>

    {% if collections.teamAlumni.length %}
      <div class="alumni-band">
        <div class="alumni-intro reveal">
          <h3>Alumni</h3>
          <p>We are grateful to the talented individuals who contributed to Whitestone Publications and continue their scholarly journeys.</p>
        </div>
        <div class="people-grid">
          {% for member in collections.teamAlumni %}
            {{ cards.person(member, metadata, { reveal: true, badge: "Alumni", alumni: true, clickable: true }) }}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="section-action reveal">
      <a href="/people/" class="button button--outline">View Full Team Directory <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
