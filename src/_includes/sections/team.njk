<section id="team" class="py-32 md:py-44 border-t border-olive/10">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16">
    <div class="grid md:grid-cols-12 gap-8 mb-16 md:mb-24 reveal">
      <div class="md:col-span-6">
        <p class="text-earth font-body font-semibold text-sm tracking-[0.3em] uppercase mb-4">Our People</p>
        <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-ink leading-[1.05] tracking-tight">
          The Minds <span class="block italic font-light text-olive">Behind the Mission</span>
        </h2>
      </div>
      <div class="md:col-span-6 md:pt-12 flex items-end">
        <p class="text-ink/60 font-body text-lg leading-[1.8] max-w-lg">Our team of scholars, editors, and board members bring decades of expertise in philosophy, cultural theory, and public scholarship to everything we publish.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {% for member in team.active %}
        {% set role = "Editorial" %}
        {% if "President" in member.role or "Secretary" in member.role or "Board" in member.role %}
          {% set role = "Leadership" %}
        {% endif %}
        <article class="team-card group relative flex flex-col bg-canvas border border-olive/15 hover:border-earth/40 transition-all duration-500 overflow-hidden reveal">
          <div class="corner corner-tl"></div>
          <div class="corner corner-br"></div>
          <div class="relative aspect-[3/3.2] overflow-hidden bg-muted">
            <img src="{{ member.photo or metadata.image }}" alt="{{ member.name }}" class="w-full h-full object-cover object-top transition-all duration-700 group-hover:scale-105 group-hover:saturate-0 group-hover:contrast-110" loading="lazy">
            <div class="absolute inset-0 bg-gradient-to-t from-ink/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 text-xs font-body font-semibold tracking-wide uppercase role-badge">{{ role }}</span>
            </div>
          </div>
          <div class="flex flex-col flex-1 p-6 md:p-7">
            <p class="text-earth font-body text-xs font-semibold tracking-[0.2em] uppercase mb-1">{{ member.role }}</p>
            <h3 class="font-heading text-xl md:text-2xl font-bold text-ink leading-tight">{{ member.name }}</h3>
            <p class="mt-4 text-ink/60 font-body text-sm leading-[1.75] flex-1">{{ member.description | stripHtml | truncate(220) }}</p>
            <a href="/people/" class="mt-5 inline-flex items-center gap-2 text-earth font-body text-sm font-semibold tracking-wide uppercase hover:gap-3 transition-all">View Full Profile <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      {% endfor %}
    </div>

    {% if team.alumni %}
      <div class="mt-24 md:mt-32 mb-12 md:mb-16 reveal">
        <div class="flex items-center gap-6">
          <div class="flex-1 h-px bg-olive/15"></div>
          <div class="flex items-center gap-3">
            <span class="text-olive/50" aria-hidden="true">●</span>
            <span class="font-body text-sm text-olive/60 tracking-[0.25em] uppercase font-semibold">Alumni</span>
          </div>
          <div class="flex-1 h-px bg-olive/15"></div>
        </div>
        <p class="mt-6 text-ink/50 font-body text-base leading-[1.8] max-w-2xl">We are grateful to the talented individuals who contributed to Whitestone Publications and continue their scholarly journeys.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {% for member in team.alumni %}
          <article class="team-card group relative flex flex-col bg-canvas border border-olive/15 hover:border-earth/40 transition-all duration-500 overflow-hidden reveal">
            <div class="relative aspect-[3/3.2] overflow-hidden bg-muted">
              <img src="{{ member.photo or metadata.image }}" alt="{{ member.name }}" class="w-full h-full object-cover object-top transition-all duration-700 group-hover:scale-105 group-hover:saturate-0 group-hover:contrast-110" loading="lazy">
              <div class="absolute top-4 left-4"><span class="px-3 py-1 text-xs font-body font-semibold tracking-wide uppercase role-badge role-badge--alumni">Alumni</span></div>
            </div>
            <div class="flex flex-col flex-1 p-6 md:p-7">
              <h3 class="font-heading text-xl md:text-2xl font-bold text-ink leading-tight">{{ member.name }}</h3>
              <p class="mt-4 text-ink/60 font-body text-sm leading-[1.75] flex-1">{{ member.description | stripHtml | truncate(220) }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    <div class="mt-16 text-center reveal">
      <a href="/people/" class="inline-flex items-center gap-3 px-10 py-4 border-2 border-earth text-earth font-body font-semibold text-sm tracking-wide uppercase hover:bg-earth hover:text-canvas transition-all duration-300">View Full Team Directory <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
