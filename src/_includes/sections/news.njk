<section id="news" class="section section--light section--border">
  <div class="site-container">
    <div class="section-heading-row reveal">
      <div>
        <p class="eyebrow">Latest News</p>
        <h2>
          Recent <span>Insights</span>
        </h2>
      </div>
      <a href="/news/" class="text-link">View All Posts <span aria-hidden="true">→</span></a>
    </div>

    <div class="news-grid">
      {% set latestPosts = collections.posts | reverse %}
      {% for item in latestPosts %}
        {% if loop.index <= 2 %}
        <article class="news-card reveal">
          <a href="{{ item.url }}">
            <div class="news-card__image">
              <img src="{% if loop.index0 == 0 %}{{ home.symposiumImage }}{% else %}{{ home.campusImage }}{% endif %}" alt="{{ item.data.title }}" loading="lazy">
            </div>
            <div class="post-meta">
              <span>{% if item.data.categories and item.data.categories.length %}{{ item.data.categories[0] }}{% else %}News{% endif %}</span>
              <time>{{ item.date | readableDate }}</time>
            </div>
            <h3>{{ item.data.title }}</h3>
            <p>{{ item.data.description or item.content | stripHtml | truncate(170) }}</p>
            <span class="text-link">Read More <span aria-hidden="true">→</span></span>
          </a>
        </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
