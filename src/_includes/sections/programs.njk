{% import "partials/icon.njk" as icons %}
<section id="programs" class="section section--light">
  <div class="site-container">
    <div class="split-heading split-heading--compact">
      <div class="reveal">
        <p class="eyebrow">Programs & Initiatives</p>
        <h2>
          Building <span>Knowledge</span>
        </h2>
      </div>
      <div class="section-copy reveal">
        <p>From scholarly journals to global symposia, our programs create spaces where critical thought flourishes and intellectual boundaries expand.</p>
      </div>
    </div>
    <div class="program-grid">
      {% for program in home.programs %}
        <div class="program-card reveal">
          <div class="corner corner-tl"></div>
          <div class="corner corner-br"></div>
          <div class="icon-box">
            {{ icons.icon(program.icon) }}
          </div>
          <h3>{{ program.title }}</h3>
          <p>{{ program.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
