{
  "name": "thewhitestonefoundation-v3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "eleventy --serve",
    "build:site": "ELEVENTY_ENV=production eleventy",
    "build:search": "npx -y pagefind --site dist --output-subdir pagefind",
    "build": "npm run build:site && npm run build:search",
    "start": "eleventy --serve"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.6",
    "js-yaml": "4.2.0",
    "markdown-it": "^14.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
