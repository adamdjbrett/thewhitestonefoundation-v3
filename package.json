{
  "name": "thewhitestonefoundation-v3",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "clean": "shx rm -rf dist",
    "dev": "eleventy --serve --port=8080",
    "build:site": "cross-env ELEVENTY_ENV=production eleventy",
    "build:search": "pagefind --site dist --output-subdir pagefind",
    "build:assets": "esbuild dist/assets/css/index.css --minify --allow-overwrite --outfile=dist/assets/css/index.css && esbuild dist/assets/js/index.js --minify --allow-overwrite --outfile=dist/assets/js/index.js",
    "build": "npm run build:site && npm run build:assets && npm run build:search",
    "deploy:xmit": "xmit",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@11ty/eleventy": "4.0.0-alpha.10",
    "@xmit.co/xmit": "0.5.2-0",
    "cross-env": "^10.1.0",
    "esbuild": "0.28.1",
    "js-yaml": "4.2.0",
    "markdown-it": "14.2.0",
    "pagefind": "^1.4.0",
    "shx": "^0.4.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@xmit.co/xmit@0.5.2-0": true,
    "fsevents@2.3.3": true
  }
}
