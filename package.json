{
  "name": "thewhitestonefoundation-v3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "clean": "shx rm -rf dist",
    "dev": "eleventy --serve --port=8080",
    "build:site": "cross-env ELEVENTY_ENV=production eleventy",
    "build:search": "pagefind --site dist --output-subdir pagefind",
    "build": "npm run build:site && npm run build:search",
    "deploy:xmit": "xmit",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@xmit.co/xmit": "0.5.2-0",
    "cross-env": "^10.1.0",
    "js-yaml": "4.2.0",
    "markdown-it": "14.2.0",
    "pagefind": "^1.4.0",
    "shx": "^0.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
