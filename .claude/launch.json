{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve",
        "dist",
        "-l",
        "8099"
      ],
      "port": 8099
    },
    {
      "name": "dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "@11ty/eleventy",
        "--serve",
        "--port=8080"
      ],
      "port": 8080
    }
  ]
}